        {
            "id": "https://meeridesign.github.io/crunchup-nut-packaging-design.html",
            "url": "https://meeridesign.github.io/crunchup-nut-packaging-design.html",
            "title": "CrunchUp Nut Packaging Design",
            "summary": "CrunchUp is all about bold flavors and good vibes. The playful packaging&hellip;",
            "content_html": "<p class=\"\" data-start=\"253\" data-end=\"559\">CrunchUp is all about bold flavors and good vibes. The playful packaging mixes real nut imagery with quirky digital collages, giving it a fun, fresh look that stands out. Whether you're at work or on the go, CrunchUp invites everyone to take a crunchy, colorful break.</p>\n<div class=\"gallery-wrapper gallery-wrapper--wide\"><div class=\"gallery\"  data-is-empty=\"false\" data-translation=\"Add images\" data-columns=\"3\">\n<figure class=\"gallery__item\"><a href=\"https://meeridesign.github.io/media/posts/4/gallery/almond-2.png\" data-size=\"2493x3697\"><img loading=\"lazy\" src=\"https://meeridesign.github.io/media/posts/4/gallery/almond-2-thumbnail.png\" alt=\"CrunchUp Nut packaging design\" width=\"768\" height=\"1139\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://meeridesign.github.io/media/posts/4/gallery/hazelnut-2.png\" data-size=\"2276x3583\"><img loading=\"lazy\" src=\"https://meeridesign.github.io/media/posts/4/gallery/hazelnut-2-thumbnail.png\" alt=\"CrunchUp Nut packaging design\" width=\"768\" height=\"1209\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://meeridesign.github.io/media/posts/4/gallery/peanut-2.png\" data-size=\"2241x3660\"><img loading=\"lazy\" src=\"https://meeridesign.github.io/media/posts/4/gallery/peanut-2-thumbnail.png\" alt=\"CrunchUp Nut packaging design\" width=\"768\" height=\"1254\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://meeridesign.github.io/media/posts/4/gallery/pattern1.5x2x-2.png\" data-size=\"4590x2084\"><img loading=\"lazy\" src=\"https://meeridesign.github.io/media/posts/4/gallery/pattern1.5x2x-2-thumbnail.png\" alt=\"CrunchUp Nut packaging design\" width=\"768\" height=\"349\"></a></figure>\n</div></div>",
            "image": "https://meeridesign.github.io/media/posts/4/istockphoto-1812772540.png",
            "author": {
                "name": "Maryam Moradi"
            },
            "tags": [
